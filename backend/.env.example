# ===================================================
# WORKKAR BACKEND ENVIRONMENT CONFIGURATION
# ===================================================

# MongoDB Connection String
# Local dev: mongodb://127.0.0.1:27017/workkar
# Atlas: mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/workkar?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/workkar

# Strong Random Secret for JWT tokens
JWT_SECRET=workkar_super_secret_jwt_key_2026_prod

# Allowed Frontend URL for CORS (e.g. your Vercel deployment URL)
CLIENT_URL=http://localhost:5173

# Port (auto-assigned on Render, defaults to 5000 in local dev)
PORT=5000
