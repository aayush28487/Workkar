# ===================================================
# WORKKAR ENVIRONMENT CONFIGURATION TEMPLATE
# ===================================================

# ---------------------------------------------------
# FRONTEND (Vite / Vercel / Netlify)
# ---------------------------------------------------
# Production Backend URL (e.g. your Render Web Service URL)
VITE_BACKEND_URL=https://workkar-backend.onrender.com

# Optional: Google OAuth Client ID
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# ---------------------------------------------------
# BACKEND (Node.js / Express / Render)
# ---------------------------------------------------
# MongoDB Atlas M0 Connection String (100% Free)
# Format: mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/workkar?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://workkar_user:your_password@cluster0.mongodb.net/workkar?retryWrites=true&w=majority

# Strong Random Secret for JWT tokens
JWT_SECRET=workkar_super_secret_jwt_key_2026_prod

# Allowed Frontend URL for CORS (e.g. your Vercel deployment URL)
CLIENT_URL=https://workkar.vercel.app

# Port (auto-assigned on Render, defaults to 5000 in local dev)
PORT=5000
